NODE_ENV=production
PORT=3000
APP_URL=https://apply.wuc.edu.gh

# Database (will use RDS later, for now use Lightsail DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wuc_admissions
DB_USER=wuc_admin
DB_PASSWORD=YourProductionPasswordHere

# JWT
JWT_SECRET=YourProductionJWTSecretHere

# AWS (Get from AWS Console)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=wuc-admissions-documents

# Email (AWS SES)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM=admissions@wuc.edu.gh

# Payment (Flutterwave - Production keys)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
FLUTTERWAVE_SECRET_KEY=FLWSECK-...