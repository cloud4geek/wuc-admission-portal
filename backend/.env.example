# ============================================================
# WUC Admission & Student Portal — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# Application
NODE_ENV=development          # development | production
PORT=5000

# CORS — Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wuc_admissions
DB_USER=wuc_admin
DB_PASSWORD=your_secure_password
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000

# ── JWT Secrets ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_random_96_char_hex_string
JWT_REFRESH_SECRET=generate_another_random_96_char_hex_string
JWT_ADMIN_SECRET=generate_yet_another_random_96_char_hex_string

# ── Encryption ─────────────────────────────────────────────
ENCRYPTION_KEY=generate_64_char_hex
SESSION_SECRET=generate_128_char_hex
RESET_TOKEN_SECRET=generate_64_char_hex
EMAIL_VERIFICATION_SECRET=generate_64_char_hex

# ── Email (Gmail / Google Workspace) ───────────────────────
# For App Password: Google Account → Security → 2FA → App Passwords
GMAIL_USER=admissions@wuc.edu.gh
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── SMS (SMSOnlineGH — portal.smsonlinegh.com) ────────────
SMSONLINEGH_API_KEY=your_smsonlinegh_api_key
SMS_SENDER_ID=WUC-ADM

# ── Payment (Paystack — dashboard.paystack.com) ────────────
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# ── URLs ───────────────────────────────────────────────────
APP_URL=http://localhost:3000      # Frontend URL
API_URL=http://localhost:5000      # Backend URL

# ── SSL (not needed if using Nginx reverse proxy) ──────────
SSL_ENABLED=false
# SSL_KEY_PATH=/etc/letsencrypt/live/domain/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/domain/fullchain.pem

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info                 # error | warn | info | debug

# ── AWS (Optional — future S3 storage) ────────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=wuc-admissions-documents
