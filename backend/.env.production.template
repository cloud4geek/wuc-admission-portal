# ============================================================
# WUC Admission Portal — Production Environment
# CRITICAL: Keep this file secure. Never commit to git.
# ============================================================

# Application
NODE_ENV=production
PORT=5000

# CORS — Production domain only
CORS_ORIGINS=https://apply.wuc.edu.gh

# Database (AWS RDS or production server)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=wuc_admissions
DB_USER=wuc_admin
DB_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
DB_SSL=true
DB_MAX_CONNECTIONS=50
DB_IDLE_TIMEOUT=30000

# JWT Configuration — GENERATE NEW SECRETS
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE
JWT_REFRESH_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE
JWT_ADMIN_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE

# Encryption — GENERATE NEW KEYS
ENCRYPTION_KEY=GENERATE_NEW_32_CHAR_HEX_HERE
SESSION_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE
RESET_TOKEN_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE
EMAIL_VERIFICATION_SECRET=GENERATE_NEW_64_CHAR_HEX_HERE

# AWS Configuration — CREATE NEW IAM USER
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_BUCKET=wuc-admissions-documents

# Email Configuration (AWS SES)
EMAIL_PROVIDER=ses
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=admissions@wuc.edu.gh
SES_REPLY_TO=admissions@wuc.edu.gh

# SMS Configuration (AWS SNS)
AWS_SNS_REGION=us-east-1
SMS_SENDER_ID=WUC-ADM

# Payment (Flutterwave Production)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK3-xxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_HASH=your_webhook_secret_from_flutterwave_dashboard

# URLs (Production)
APP_URL=https://apply.wuc.edu.gh
API_URL=https://api.apply.wuc.edu.gh

# SSL Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/wuc.crt
SSL_KEY_PATH=/etc/ssl/private/wuc.key
HTTPS_PORT=443

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Rate Limiting (Production - Strict)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
